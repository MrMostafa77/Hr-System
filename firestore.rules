rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc() { return /databases/$(database)/documents/hr_users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userDoc()); }
    function isActive() { return hasProfile() && get(userDoc()).data.get('disabled', false) != true; }
    function isAdmin() { return isActive() && get(userDoc()).data.role == 'admin'; }
    // صلاحية البيانات المالية: المدير أو مستخدم لديه finance = true
    function canFinance() { return isAdmin() || (isActive() && get(userDoc()).data.get('finance', false) == true); }
    function noBootstrapYet() { return !exists(/databases/$(database)/documents/hr_meta/access); }

    // الوثيقة العامة (بدون رواتب/بنوك/أسعار): أي مستخدم نشط.
    // الكتابة تشترط النسق الجديد schema == 2 وعدم احتواء مفاتيح مالية، فيُمنع أي كود قديم مخزّن بالمتصفح من إعادة كتابة كل شيء هنا.
    match /hr_system/main {
      allow read: if isActive();
      allow write: if isActive()
        && request.resource.data.get('schema', 0) == 2
        && !request.resource.data.keys().hasAny(['payrollRecords', 'projectAccounts']);
    }
    // ملفات الموظفين (مرفقات base64)
    match /hr_system/main/employee_files/{fileId} {
      allow read, write: if isActive();
    }

    // البيانات المالية: فقط المدير أو من لديه صلاحية المالية
    match /hr_finance/{docId} {
      allow read, write: if canFinance();
    }

    // الصلاحيات: المستخدم يقرأ مستنده فقط، والمدير يقرأ ويكتب الكل
    match /hr_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // أول مدير فقط (قبل وجود hr_meta/access) يستطيع إنشاء مستند لنفسه
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'admin' && noBootstrapYet());
      allow update, delete: if isAdmin();
    }

    // علامة أن أول مدير تم إنشاؤه (تُكتب مرة واحدة)
    match /hr_meta/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && noBootstrapYet();
      allow update, delete: if false;
    }
  }
}
